{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "plugins/*/src/**/*.ts",
    "plugins/*/test/**/*.ts",
    "*.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["packages/web"]
}
